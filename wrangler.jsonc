{
  "name": "monitor-visivo",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./site", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  // Scheduler: lancia bases.yml dal lunedì al venerdì alle 22:30 UTC. Cloudflare numera i giorni da 1 = DOMENICA:
  // per questo si usano i nomi, e il codice filtra comunque il giorno (src/dati.js). Free: max 5 cron.
  "triggers": { "crons": ["30 22 * * mon-fri"] },
  // Database D1 «basewatch» (punteggi riservati e log dello scheduler).
  "d1_databases": [{ "binding": "DB", "database_name": "basewatch", "database_id": "90e41efa-031d-4b5f-93ea-38da1a08369c" }],
  // Variabili non segrete (secret nella dashboard Cloudflare: AI_KEY, GITHUB_TOKEN e, finché non c'è Access, ACCESS_CODE).
  "vars": {
    "AI_BASE_URL": "https://api.groq.com/openai/v1",
    "AI_MODEL": "qwen/qwen3.8-27b",
    "AI_VISION": "true",
    "AI_MAX_TOKENS": "4000",
    // Cloudflare Access: compilare ACCESS_TEAM_DOMAIN (es. nome.cloudflareaccess.com) e ACCESS_AUD per attivare il login.
    "ACCESS_TEAM_DOMAIN": "weathered-field-3c85.cloudflareaccess.com",
    "ACCESS_AUD": "5a2884b915c8478a754fb0bb5b208d919763697f279841616b820e30cf1b2e28",
    "ADMIN_EMAILS": "lorenzetti1984@gmail.com",
    // «1» quando la regola di Access lascia entrare chiunque verifichi la propria email (il portale decide chi è abilitato).
    "ACCESSO_APERTO": "1"
  }
}
