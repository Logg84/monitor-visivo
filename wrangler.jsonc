{
  "name": "monitor-visivo",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./site", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  // Variabili non segrete (i secret AI_KEY e ACCESS_CODE si impostano nella dashboard Cloudflare).
  "vars": {
    "AI_BASE_URL": "https://api.groq.com/openai/v1",
    "AI_MODEL": "qwen/qwen3.8-27b",
    "AI_VISION": "true",
    "AI_MAX_TOKENS": "4000"
  }
}
